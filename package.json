{
  "name": "toranjplastic",
  "version": "0.0.0",
  "private": true,
  "description": "Toranj Plastic specification-driven monorepo",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=24.11.0",
    "pnpm": ">=9.15.0"
  },
  "scripts": {
    "dev": "node scripts/run-with-root-env.mjs dev:services",
    "dev:services": "pnpm --parallel --filter frontend --filter backend dev",
    "dev:frontend": "node scripts/run-with-root-env.mjs dev:frontend:service",
    "dev:frontend:service": "pnpm --filter frontend dev",
    "dev:backend": "node scripts/run-with-root-env.mjs dev:backend:service",
    "dev:backend:service": "pnpm --filter backend dev",
    "dev:cms": "node scripts/run-with-root-env.mjs dev:cms:service",
    "dev:cms:service": "pnpm --filter cms dev",
    "start:cms": "node scripts/run-with-root-env.mjs start:cms:service",
    "start:cms:service": "pnpm --filter cms start",
    "build": "pnpm -r build",
    "build:cms": "pnpm --filter cms build",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "test:e2e:backend": "pnpm --filter backend test:e2e",
    "test:e2e:frontend": "pnpm --filter frontend test:e2e",
    "test:e2e": "pnpm test:e2e:backend && pnpm test:e2e:frontend",
    "test:integration:postgres": "pnpm --filter backend test:integration:postgres",
    "typecheck": "pnpm -r typecheck",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "check:architecture": "pnpm --filter frontend check:architecture && pnpm --filter frontend test:architecture",
    "db:generate": "pnpm --filter backend db:generate",
    "db:migrate": "node scripts/run-with-root-env.mjs db:migrate:service",
    "db:migrate:service": "pnpm --filter backend db:migrate",
    "db:migrate:deploy": "node scripts/run-with-root-env.mjs db:migrate:deploy:service",
    "db:migrate:deploy:service": "pnpm --filter backend db:migrate:deploy",
    "db:studio": "node scripts/run-with-root-env.mjs db:studio:service",
    "db:studio:service": "pnpm --filter backend db:studio",
    "admin:bootstrap": "node scripts/run-with-root-env.mjs admin:bootstrap:service",
    "admin:bootstrap:service": "pnpm --filter backend admin:bootstrap"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "^19",
      "@types/react-dom": "^19"
    }
  }
}
