generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum UserRole {
  CUSTOMER
  ADMIN
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  DISABLED
}

model User {
  id           String              @id @default(cuid())
  mobile       String              @unique
  displayName  String
  email        String?
  companyName  String?
  role         UserRole            @default(CUSTOMER)
  status       AccountStatus       @default(ACTIVE)
  lastLoginAt  DateTime?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  password     PasswordCredential?
  sessions     AuthSession[]
  auditEvents  SecurityAuditEvent[]

  @@index([role, status])
}

model PasswordCredential {
  userId       String   @id
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuthSession {
  id          String    @id @default(cuid())
  tokenDigest String    @unique
  csrfDigest  String
  userId      String
  expiresAt   DateTime
  revokedAt   DateTime?
  lastSeenAt  DateTime  @default(now())
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt, revokedAt])
}

model SecurityAuditEvent {
  id        String   @id @default(cuid())
  action    String
  userId    String?
  metadata  Json?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([action, createdAt])
  @@index([userId, createdAt])
}

model Category {
  id              String        @id @default(cuid())
  name            String
  slug            String        @unique
  description     String?       @db.Text
  image           Json?
  displayOrder    Int           @default(0)
  status          ContentStatus @default(DRAFT)
  publishedAt     DateTime?
  metaTitle       String?
  metaDescription String?       @db.Text
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  products        Product[]

  @@index([status, publishedAt, displayOrder])
}

model Product {
  id              String        @id @default(cuid())
  name            String
  slug            String        @unique
  summary         String?       @db.Text
  description     String?       @db.Text
  categoryId      String?
  category        Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  images          Json          @default("[]")
  specifications  Json          @default("[]")
  displayOrder    Int           @default(0)
  featured        Boolean       @default(false)
  status          ContentStatus @default(DRAFT)
  publishedAt     DateTime?
  metaTitle       String?
  metaDescription String?       @db.Text
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([status, publishedAt, displayOrder])
  @@index([categoryId])
  @@index([featured, status, publishedAt])
}

model InjectionService {
  id              String        @id @default(cuid())
  name            String
  slug            String        @unique
  summary         String?       @db.Text
  description     String?       @db.Text
  images          Json          @default("[]")
  specifications  Json          @default("[]")
  ctaLabel        String?
  ctaHref         String?
  displayOrder    Int           @default(0)
  status          ContentStatus @default(DRAFT)
  publishedAt     DateTime?
  metaTitle       String?
  metaDescription String?       @db.Text
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([status, publishedAt, displayOrder])
}

model Material {
  id               String        @id @default(cuid())
  name             String
  slug             String        @unique
  family           String?
  grade            String?
  manufacturer     String?
  summary          String?       @db.Text
  description      String?       @db.Text
  images           Json          @default("[]")
  specifications   Json          @default("[]")
  inquiryAvailable Boolean       @default(true)
  displayOrder     Int           @default(0)
  status           ContentStatus @default(DRAFT)
  publishedAt      DateTime?
  metaTitle        String?
  metaDescription  String?       @db.Text
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([status, publishedAt, displayOrder])
}

model Article {
  id              String        @id @default(cuid())
  title           String
  slug            String        @unique
  summary         String?       @db.Text
  body            String        @db.Text
  featuredImage   Json?
  displayOrder    Int           @default(0)
  status          ContentStatus @default(DRAFT)
  publishedAt     DateTime?
  metaTitle       String?
  metaDescription String?       @db.Text
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([status, publishedAt, displayOrder])
}

model ManagedPage {
  id              String        @id @default(cuid())
  title           String
  slug            String        @unique
  summary         String?       @db.Text
  body            String        @db.Text
  images          Json          @default("[]")
  displayOrder    Int           @default(0)
  status          ContentStatus @default(DRAFT)
  publishedAt     DateTime?
  metaTitle       String?
  metaDescription String?       @db.Text
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([status, publishedAt, displayOrder])
}
