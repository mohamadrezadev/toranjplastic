generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum UserRole {
  CUSTOMER
  ADMIN
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  DISABLED
}

enum InquiryType {
  PRODUCT
  INJECTION_SERVICE
  MATERIAL
  GENERAL_CONTACT
}

enum InquiryStatus {
  SUBMITTED
  UNDER_REVIEW
  NEED_MORE_INFO
  QUOTED
  ACCEPTED
  IN_PROGRESS
  COMPLETED
  REJECTED
  CANCELLED
}

enum MaterialRequestKind {
  PRICE_QUOTE
  SUPPLY_REQUEST
  AVAILABILITY_REVIEW
}

enum MaterialCondition {
  NEW
  RECYCLED
}

model User {
  id           String              @id @default(cuid())
  mobile       String              @unique
  displayName  String
  email        String?
  companyName  String?
  role         UserRole            @default(CUSTOMER)
  status       AccountStatus       @default(ACTIVE)
  lastLoginAt  DateTime?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  password     PasswordCredential?
  sessions     AuthSession[]
  auditEvents  SecurityAuditEvent[]
  inquiries    Inquiry[]             @relation("InquiryOwner")
  inquiryHistory InquiryStatusHistory[] @relation("InquiryHistoryActor")

  @@index([role, status])
}

model PasswordCredential {
  userId       String   @id
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuthSession {
  id          String    @id @default(cuid())
  tokenDigest String    @unique
  csrfDigest  String
  userId      String
  expiresAt   DateTime
  revokedAt   DateTime?
  lastSeenAt  DateTime  @default(now())
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt, revokedAt])
}

model SecurityAuditEvent {
  id        String   @id @default(cuid())
  action    String
  userId    String?
  metadata  Json?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([action, createdAt])
  @@index([userId, createdAt])
}

model Category {
  id              String        @id @default(cuid())
  name            String
  slug            String        @unique
  description     String?       @db.Text
  image           Json?
  displayOrder    Int           @default(0)
  status          ContentStatus @default(DRAFT)
  publishedAt     DateTime?
  metaTitle       String?
  metaDescription String?       @db.Text
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  products        Product[]

  @@index([status, publishedAt, displayOrder])
}

model Product {
  id              String        @id @default(cuid())
  name            String
  slug            String        @unique
  summary         String?       @db.Text
  description     String?       @db.Text
  categoryId      String?
  category        Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  images          Json          @default("[]")
  specifications  Json          @default("[]")
  displayOrder    Int           @default(0)
  featured        Boolean       @default(false)
  status          ContentStatus @default(DRAFT)
  publishedAt     DateTime?
  metaTitle       String?
  metaDescription String?       @db.Text
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  inquiries       Inquiry[]

  @@index([status, publishedAt, displayOrder])
  @@index([categoryId])
  @@index([featured, status, publishedAt])
}

model InjectionService {
  id              String        @id @default(cuid())
  name            String
  slug            String        @unique
  summary         String?       @db.Text
  description     String?       @db.Text
  images          Json          @default("[]")
  specifications  Json          @default("[]")
  ctaLabel        String?
  ctaHref         String?
  displayOrder    Int           @default(0)
  status          ContentStatus @default(DRAFT)
  publishedAt     DateTime?
  metaTitle       String?
  metaDescription String?       @db.Text
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  inquiries       Inquiry[]

  @@index([status, publishedAt, displayOrder])
}

model Material {
  id               String        @id @default(cuid())
  name             String
  slug             String        @unique
  family           String?
  grade            String?
  manufacturer     String?
  summary          String?       @db.Text
  description      String?       @db.Text
  images           Json          @default("[]")
  specifications   Json          @default("[]")
  inquiryAvailable Boolean       @default(true)
  displayOrder     Int           @default(0)
  status           ContentStatus @default(DRAFT)
  publishedAt      DateTime?
  metaTitle        String?
  metaDescription  String?       @db.Text
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  inquiries        Inquiry[]

  @@index([status, publishedAt, displayOrder])
}

model Article {
  id              String        @id @default(cuid())
  title           String
  slug            String        @unique
  summary         String?       @db.Text
  body            String        @db.Text
  featuredImage   Json?
  displayOrder    Int           @default(0)
  status          ContentStatus @default(DRAFT)
  publishedAt     DateTime?
  metaTitle       String?
  metaDescription String?       @db.Text
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([status, publishedAt, displayOrder])
}

model ManagedPage {
  id              String        @id @default(cuid())
  title           String
  slug            String        @unique
  summary         String?       @db.Text
  body            String        @db.Text
  images          Json          @default("[]")
  displayOrder    Int           @default(0)
  status          ContentStatus @default(DRAFT)
  publishedAt     DateTime?
  metaTitle       String?
  metaDescription String?       @db.Text
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([status, publishedAt, displayOrder])
}

model Inquiry {
  id                 String               @id @default(cuid())
  type               InquiryType
  status             InquiryStatus        @default(SUBMITTED)
  ownerId            String
  owner              User                 @relation("InquiryOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  productId          String?
  product            Product?             @relation(fields: [productId], references: [id], onDelete: SetNull)
  injectionServiceId String?
  injectionService   InjectionService?    @relation(fields: [injectionServiceId], references: [id], onDelete: SetNull)
  materialId         String?
  material           Material?            @relation(fields: [materialId], references: [id], onDelete: SetNull)
  catalogItemName    String?
  description        String?              @db.Text
  approximateQuantity String?
  quantityUnit       String?
  deliveryCity       String?
  requestedTiming    String?
  partDescription    String?              @db.Text
  moldStatus         String?
  materialName       String?
  color              String?
  materialRequestKind MaterialRequestKind?
  polymerName        String?
  grade              String?
  brand              String?
  materialCondition  MaterialCondition?
  application        String?              @db.Text
  specifications     String?              @db.Text
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  statusHistory      InquiryStatusHistory[]

  @@index([ownerId, createdAt])
  @@index([ownerId, type, createdAt])
  @@index([ownerId, status, createdAt])
  @@index([productId])
  @@index([injectionServiceId])
  @@index([materialId])
}

model InquiryStatusHistory {
  id         String        @id @default(cuid())
  inquiryId  String
  inquiry    Inquiry       @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  fromStatus InquiryStatus?
  toStatus   InquiryStatus
  actorId    String
  actor      User          @relation("InquiryHistoryActor", fields: [actorId], references: [id], onDelete: Restrict)
  createdAt  DateTime      @default(now())

  @@index([inquiryId, createdAt])
  @@index([actorId, createdAt])
}
