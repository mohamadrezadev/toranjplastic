generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model Category {
  id              String        @id @default(cuid())
  name            String
  slug            String        @unique
  description     String?       @db.Text
  image           Json?
  displayOrder    Int           @default(0)
  status          ContentStatus @default(DRAFT)
  publishedAt     DateTime?
  metaTitle       String?
  metaDescription String?       @db.Text
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  products        Product[]

  @@index([status, publishedAt, displayOrder])
}

model Product {
  id              String        @id @default(cuid())
  name            String
  slug            String        @unique
  summary         String?       @db.Text
  description     String?       @db.Text
  categoryId      String?
  category        Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  images          Json          @default("[]")
  specifications  Json          @default("[]")
  displayOrder    Int           @default(0)
  featured        Boolean       @default(false)
  status          ContentStatus @default(DRAFT)
  publishedAt     DateTime?
  metaTitle       String?
  metaDescription String?       @db.Text
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([status, publishedAt, displayOrder])
  @@index([categoryId])
  @@index([featured, status, publishedAt])
}

model InjectionService {
  id              String        @id @default(cuid())
  name            String
  slug            String        @unique
  summary         String?       @db.Text
  description     String?       @db.Text
  images          Json          @default("[]")
  specifications  Json          @default("[]")
  ctaLabel        String?
  ctaHref         String?
  displayOrder    Int           @default(0)
  status          ContentStatus @default(DRAFT)
  publishedAt     DateTime?
  metaTitle       String?
  metaDescription String?       @db.Text
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([status, publishedAt, displayOrder])
}

model Material {
  id               String        @id @default(cuid())
  name             String
  slug             String        @unique
  family           String?
  grade            String?
  manufacturer     String?
  summary          String?       @db.Text
  description      String?       @db.Text
  images           Json          @default("[]")
  specifications   Json          @default("[]")
  inquiryAvailable Boolean       @default(true)
  displayOrder     Int           @default(0)
  status           ContentStatus @default(DRAFT)
  publishedAt      DateTime?
  metaTitle        String?
  metaDescription  String?       @db.Text
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([status, publishedAt, displayOrder])
}

model Article {
  id              String        @id @default(cuid())
  title           String
  slug            String        @unique
  summary         String?       @db.Text
  body            String        @db.Text
  featuredImage   Json?
  displayOrder    Int           @default(0)
  status          ContentStatus @default(DRAFT)
  publishedAt     DateTime?
  metaTitle       String?
  metaDescription String?       @db.Text
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([status, publishedAt, displayOrder])
}

model ManagedPage {
  id              String        @id @default(cuid())
  title           String
  slug            String        @unique
  summary         String?       @db.Text
  body            String        @db.Text
  images          Json          @default("[]")
  displayOrder    Int           @default(0)
  status          ContentStatus @default(DRAFT)
  publishedAt     DateTime?
  metaTitle       String?
  metaDescription String?       @db.Text
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([status, publishedAt, displayOrder])
}
