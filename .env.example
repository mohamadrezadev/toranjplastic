NODE_ENV=development
FRONTEND_PORT=3000
BACKEND_PORT=3001
FRONTEND_ORIGIN=http://localhost:3000
# Set to the verified production origin before deployment; used for canonical and sitemap URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
BACKEND_API_URL=http://localhost:3001/api/v1
POSTGRES_DB=toranj
POSTGRES_USER=toranj
POSTGRES_PASSWORD=change-me-locally
POSTGRES_PORT=5433
DATABASE_URL=postgresql://toranj:change-me-locally@localhost:5433/toranj?schema=public
AUTH_SESSION_DAYS=7
AUTH_LOGIN_LIMIT=10
AUTH_LOGIN_WINDOW_SECONDS=900
AUTH_COOKIE_SECURE=false
# Media storage is provider-neutral. Production must bind MEDIA_ROOT to the
# verified persistent mount and must use an application-owned HTTPS origin.
MEDIA_STORAGE_PROVIDER=mounted-disk
MEDIA_ROOT=/absolute/path/to/mounted/media
MEDIA_PUBLIC_ORIGIN=http://localhost:3001
MEDIA_MAX_UPLOAD_BYTES=10485760
# Must be greater than MEDIA_MAX_UPLOAD_BYTES to include multipart form overhead.
MEDIA_SERVER_ACTION_BODY_SIZE_LIMIT_BYTES=11534336
MEDIA_MAX_PIXELS=20000000
MEDIA_MIN_FREE_BYTES=1073741824
MEDIA_MAX_PRODUCT_IMAGES=6
MEDIA_PROCESSING_CONCURRENCY=2
MEDIA_TEMP_RETENTION_HOURS=24
MEDIA_UNATTACHED_RETENTION_DAYS=30
# One-time operator command only; never commit real values.
BOOTSTRAP_ADMIN_MOBILE=
BOOTSTRAP_ADMIN_DISPLAY_NAME=
BOOTSTRAP_ADMIN_PASSWORD=

# Strapi Headless CMS (Editorial Articles only)
# In production, STRAPI_APP_KEYS, STRAPI_API_TOKEN_SALT, STRAPI_ADMIN_JWT_SECRET,
# STRAPI_TRANSFER_TOKEN_SALT, STRAPI_DATABASE_PASSWORD and STRAPI_REVALIDATE_SECRET
# are mandatory and must be cryptographically secure non-default strings.
STRAPI_PORT=1337
STRAPI_HOST=0.0.0.0
STRAPI_DATABASE_CLIENT=postgres
STRAPI_DATABASE_HOST=localhost
STRAPI_DATABASE_PORT=5433
STRAPI_DATABASE_NAME=toranj_strapi
STRAPI_DATABASE_USERNAME=toranj
STRAPI_DATABASE_PASSWORD=change-me-locally
STRAPI_DATABASE_SSL=false
STRAPI_APP_KEYS=sample_app_key_1,sample_app_key_2
STRAPI_API_TOKEN_SALT=sample_api_token_salt
STRAPI_ADMIN_JWT_SECRET=sample_admin_jwt_secret
STRAPI_TRANSFER_TOKEN_SALT=sample_transfer_token_salt
STRAPI_JWT_SECRET=sample_jwt_secret
STRAPI_URL=http://localhost:1337
STRAPI_API_URL=http://localhost:1337
STRAPI_API_TOKEN=
STRAPI_REVALIDATE_SECRET=change-me-locally
STRAPI_REVALIDATION_SECRET=change-me-locally

# SMS Notifications (Transactional Templates)
SMS_PROVIDER=mock
SMS_API_KEY=
SMS_SENDER=
ADMIN_NOTIFICATION_MOBILE=09120000000


