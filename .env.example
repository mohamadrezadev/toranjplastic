NODE_ENV=development
FRONTEND_PORT=3000
BACKEND_PORT=3001
FRONTEND_ORIGIN=http://localhost:3000
# Set to the verified production origin before deployment; used for canonical and sitemap URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
BACKEND_API_URL=http://localhost:3001/api/v1
POSTGRES_DB=toranj
POSTGRES_USER=toranj
POSTGRES_PASSWORD=change-me-locally
DATABASE_URL=postgresql://toranj:change-me-locally@localhost:5432/toranj?schema=public
AUTH_SESSION_DAYS=7
AUTH_LOGIN_LIMIT=10
AUTH_LOGIN_WINDOW_SECONDS=900
AUTH_COOKIE_SECURE=false
# One-time operator command only; never commit real values.
BOOTSTRAP_ADMIN_MOBILE=
BOOTSTRAP_ADMIN_DISPLAY_NAME=
BOOTSTRAP_ADMIN_PASSWORD=
